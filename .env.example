VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_SITE_URL=https://your-production-domain.com
VITE_CONTACT_WHATSAPP=2348012345678

# Flutterwave test-mode secret; only read by payment-server.mjs, never expose
# it with a VITE_ prefix. Add your FLWSECK_TEST- key to .env.local.
FLW_SECRET_KEY=FLWSECK_TEST-your-test-secret-key
FLW_CURRENCY=USD

# Optional: point product and payment requests at your deployed backend.
# Local development uses the project's db.json through the Vite proxy.
# VITE_PAYMENT_API_URL=https://your-payment-api.example/api
# VITE_PRODUCTS_API_URL=https://your-products-api.example/api
